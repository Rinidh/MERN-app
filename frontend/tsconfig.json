{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": false,
    "noImplicitAny": false,

    "skipLibCheck": true,
    "isolatedModules": true,

    "resolveJsonModule": true,
    "useDefineForClassFields": true
  },
  "include": ["src"]
}
