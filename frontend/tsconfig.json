{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vitest/globals"],

    "strict": false,
    "noImplicitAny": false,

    "skipLibCheck": true,
    "isolatedModules": true,

    "resolveJsonModule": true,
    "useDefineForClassFields": true,

    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src", "__tests__"]
}
